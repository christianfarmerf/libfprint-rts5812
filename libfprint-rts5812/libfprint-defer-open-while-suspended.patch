+/* Start an open that fp_device_open() parked while the device was suspended;
+ * scheduled (as an idle) by fpi_device_resume_complete(). */
+static gboolean
+fp_device_run_pending_open (gpointer user_data)
+{
+  FpDevice *device = user_data;
+  FpDevicePrivate *priv = fp_device_get_instance_private (device);
+  GTask *task = g_steal_pointer (&priv->pending_open_task);
+
+  if (!task)
+    return G_SOURCE_REMOVE;
+
+  g_debug ("Running open deferred during suspend");
+  if (priv->current_task || priv->is_suspended || priv->is_open)
+    {
+      g_task_return_error (task, fpi_device_error_new (FP_DEVICE_ERROR_BUSY));
+      g_object_unref (task);
+    }
+  else
+    {
+      fpi_device_open_start (device, task);   /* takes ownership */
+    }
+
+  return G_SOURCE_REMOVE;
+}
+
