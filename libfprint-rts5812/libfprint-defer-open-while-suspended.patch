 }
 
+static void
+open_while_suspended_cb (GObject *device, GAsyncResult *res, gpointer user_data)
+{
+  GError **error = user_data;
+  gboolean ok = fp_device_open_finish (FP_DEVICE (device), res, error);
+
+  g_assert_true (ok || *error);
+  g_object_set_data (device, "open-done", GINT_TO_POINTER (TRUE));
+}
+
+static void
+test_driver_open_while_suspended (void)
+{
+  g_autoptr(FpAutoResetClass) dev_class = auto_reset_device_class ();
+  g_autoptr(FpAutoCloseDevice) device = NULL;
+  g_autoptr(GError) error = NULL;
+  FpiDeviceFake *fake_dev;
+
+  device = g_object_new (FPI_TYPE_DEVICE_FAKE, NULL);
+  fake_dev = FPI_DEVICE_FAKE (device);
+
+  fp_device_suspend (device, NULL, (GAsyncReadyCallback) fp_device_suspend_finish, &error);
+  while (g_main_context_iteration (NULL, FALSE))
+    continue;
+  g_assert_no_error (error);
+
+  /* An open while suspended is parked, not failed with BUSY ... */
+  fp_device_open (device, NULL, open_while_suspended_cb, &error);
+  while (g_main_context_iteration (NULL, FALSE))
+    continue;
+  g_assert_null (g_object_get_data (G_OBJECT (device), "open-done"));
+  g_assert (fake_dev->last_called_function == NULL);
+  g_assert_false (fp_device_is_open (device));
+
+  /* ... and runs once the device resumes. */
+  fp_device_resume (device, NULL, (GAsyncReadyCallback) fp_device_resume_finish, NULL);
+  while (!g_object_get_data (G_OBJECT (device), "open-done"))
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_no_error (error);
+  g_assert (fake_dev->last_called_function == dev_class->open);
+  g_assert_true (fp_device_is_open (device));
+}
